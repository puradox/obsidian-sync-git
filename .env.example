# Env-file template for `docker run --env-file bridge.env ...`.
# Format is KEY=value, one per line — no quotes, no shell expansion, no
# multi-line values. Copy to bridge.env and fill in. Keep it mode 600; it holds
# secrets. The SSH deploy key is multi-line and CANNOT live here — pass it with
# `-e GIT_DEPLOY_KEY="$(cat deploy_key)"` or mount it and set GIT_DEPLOY_KEY_FILE
# (see docs/REFERENCE.md, Security).

# ---- required ----
# Obsidian Sync remote vault name (or its id). Get it with: ob sync-list-remote
# Fixed once volumes exist — the bridge refuses changes at startup.
VAULT_NAME=My Vault
# GitHub remote, SSH form. The deploy key must have write access.
GIT_REMOTE_URL=git@github.com:owner/repo.git
# Non-interactive Obsidian auth token (see README setup step 2).
OBSIDIAN_AUTH_TOKEN=

# ---- optional ----
# E2EE vault password (leave blank for standard/managed vaults).
OBSIDIAN_VAULT_PASSWORD=

# Cycle cadence (standard 5-field cron).
# CRON_SCHEDULE=*/15 * * * *

# Commit identity.
# GIT_AUTHOR_NAME=Obsidian Bridge
# GIT_AUTHOR_EMAIL=obsidian-bridge@localhost

# ---- optional: AI commit messages ----
# Option A: an OpenAI-compatible provider (takes precedence over Anthropic).
#   Groq:    LLM_API_BASE=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.1-8b-instant
#   Gemini:  LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.1-flash-lite
#   Ollama:  LLM_API_BASE=http://host.docker.internal:11434/v1                     LLM_MODEL=qwen2.5:3b
LLM_API_BASE=
LLM_MODEL=
LLM_API_KEY=
# LLM_MAX_TOKENS=1024
# Option B: native Anthropic (used only if LLM_* above is unset).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# ---- optional overrides ----
# Vault located in a subdirectory of the repo (e.g. VAULT_SUBDIR=vault), so
# support files (a Quartz site, automation skills, ...) can live in git without
# being synced to Obsidian devices. Default: the vault is the repo root.
# Fixed once volumes exist — the bridge refuses changes at startup.
# VAULT_SUBDIR=
# Healthcheck staleness threshold, in whole seconds (integer only). Auto-derives
# 2x the interval for */N schedules; SET THIS for any other schedule (hourly,
# daily, comma-lists).
# HEALTH_STALE_SECONDS=1800
# Run one bridge cycle at container start (default true).
# RUN_ON_START=true
# Non-default Obsidian config dir (default .obsidian).
# OBSIDIAN_CONFIG_DIR=.obsidian
# Device name shown in Obsidian Sync's version history.
# OBSIDIAN_DEVICE_NAME=git-bridge
